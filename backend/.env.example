# Required: speech-to-text + text-to-speech (OpenAI)
OPENAI_API_SECRET=

# Required: conversation (Google Gemini)
GEMINI_API_KEY=

# Auth. If JWT_SECRET is unset a random one is used and restarts log everyone out.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_DAYS=7
SESSION_DURATION_SECONDS=1200

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fluently

# OTP / email delivery. Leave SMTP_HOST unset to print codes to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fluently <no-reply@example.com>
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60

# Operational alerts (defaults to SMTP_USER)
ALERT_EMAIL_TO=
LLM_ALERT_COOLDOWN_MINUTES=180

# Optional login allowlist (comma-separated). Empty = anyone can log in.
# Others can sign up but stay locked, and ADMIN_NOTIFY_EMAIL (default ALERT_EMAIL_TO) is emailed.
ALLOWED_LOGIN_EMAILS=
ADMIN_NOTIFY_EMAIL=
